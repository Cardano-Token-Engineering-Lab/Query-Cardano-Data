# Copy this file to .env and fill in your own keys. Never commit the real .env file.

# Required for the Blockfrost backend (sources/blockfrost_source.py).
# Get a free-tier key at https://blockfrost.io/
BLOCKFROST_API_TOKEN=your_blockfrost_project_id_here

# Koios (sources/koios_source.py) does not require a key for its public
# tier as of this writing. If Koios introduces paid-tier auth in the future,
# add the relevant variable here and wire it into KoiosSource.
